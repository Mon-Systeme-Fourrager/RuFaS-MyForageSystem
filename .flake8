[flake8]
count = True
show-source = True
statistics = True
max-line-length = 120
max-complexity = 10
ignore = E203, W503
exclude = .git,__pycache__,.venv,venv,build,dist,.mypy_cache,.pytest_cache
# Upstream economics (RuFaS #2588) ships functions above the complexity limit and is being rewritten upstream
# (RuFaS #3197); refactoring it here would only add conflicts at each upstream sync. Remove once upstream lands.
per-file-ignores =
    RUFAS/EEE/economics/*.py: C901
